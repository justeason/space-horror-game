extends "res://scripts/station/equipment_base.gd"
## Round 38 Priorities 4, 12, 13: EXTERIOR ANTENNA MAST A1 and the COMMS
## LINK -- the first EVA maintenance task and a new multi-room chain.
##   Mast A1 stands in the courtyard between the Control Room, the Airlock
##   tunnel and Engineering: visible through the Control Room observation
##   port, from cameras EXT-03 / EXT-04, and reachable on the EVA walkway.
##   At its base: the FEED BOX (weather cover + RF connector).
## Faults (generated by the work order, saved, never re-rolled):
##   "loose"    -- the RF connector has backed off: reseat it;
##   "corroded" -- contacts corroded: clean, then reseat.
## The cover must be closed again (weather seal) to finish.
## Real consequence: COMMS LINK quality = power (breaker B-04 COMMS) x
## antenna feed (1.0 ok, 0.55 corroded, 0.35 loose). Shown on the COMMS
## LINK panel in the Communications room (bar meter + TEST LINK button)
## and in the workstation Operations data.
## Work order "antenna" (chain, category D): test the link in Comms ->
## suit up -> cycle out -> service the feed box -> cycle in -> verify the
## link in Comms.

const MAST := Vector3(-2.85, 0.0, 0.75)
const BOX := Vector3(-3.06, 0.85, 0.75)
const PANEL := Vector3(2.95, 1.45, 8.18)
@export var breaker_path: NodePath = ^"../BreakerPanel"

var feed: String = "ok"           # "ok" | "loose" | "corroded"
var cover_open: bool = false
var request_day: int = -1
var link_checked: bool = false
var verified_day: int = -1
var _cover: Node3D
var _connector: CSGBox3D
var _box_lamp: StandardMaterial3D
var _bar: CSGBox3D
var _link_label: Label3D
var _link_lamp: StandardMaterial3D
var _t: float = 0.0


func _ready() -> void:
	_base_ready(&"antenna")
	add_to_group(&"antenna")
	_build_mast()
	_build_panel()
	_refresh()


func _ext(m: Node3D) -> void:
	for v in [m] + m.find_children("*", "VisualInstance3D", true, false):
		if v is VisualInstance3D:
			(v as VisualInstance3D).layers = 1 | (1 << 11)


func _build_mast() -> void:
	var root := Node3D.new()
	root.name = "MastA1"
	root.position = MAST
	add_child(root)
	var grey := Color(0.7, 0.72, 0.74)
	# Mast, base flange and the antenna head.
	var mast := CSGCylinder3D.new()
	mast.radius = 0.07
	mast.height = 3.3
	mast.position.y = 1.65
	var mm := StandardMaterial3D.new()
	mm.albedo_color = grey
	mm.metallic = 0.6
	mast.material = mm
	root.add_child(mast)
	box(Vector3(0.6, 0.06, 0.6), Vector3(0, 0.03, 0), Color(0.35, 0.37, 0.4), root)
	for k in 4:
		var el := box(Vector3(0.9 - k * 0.15, 0.025, 0.025), Vector3(0, 2.75 + k * 0.16, 0), Color(0.88, 0.88, 0.86), root)
		el.rotation_degrees.y = 35.0
	box(Vector3(0.03, 0.6, 0.03), Vector3(0, 3.0, 0), Color(0.88, 0.88, 0.86), root)
	var beacon := lamp(Vector3(0, 3.35, 0), root, 0.035)
	set_lamp(beacon, Color(1.0, 0.25, 0.15), true)
	# Feed box at the base, door facing the walkway (-X).
	var fb := Node3D.new()
	fb.name = "FeedBox"
	fb.position = BOX
	fb.rotation_degrees.y = -90.0
	add_child(fb)
	box(Vector3(0.34, 0.4, 0.18), Vector3(0, 0, -0.06), Color(0.85, 0.85, 0.82), fb)
	label("FEED A1", Vector3(0, 0.25, 0.04), 20, Color(0.15, 0.15, 0.15), fb)
	_connector = box(Vector3(0.07, 0.07, 0.08), Vector3(0, -0.02, 0.04), Color(0.75, 0.6, 0.3), fb)
	box(Vector3(0.025, 0.25, 0.025), Vector3(0, -0.18, 0.04), Color(0.1, 0.1, 0.1), fb)   # coax down to the hull
	_box_lamp = lamp(Vector3(0.13, 0.15, 0.04), fb)
	_cover = Node3D.new()
	_cover.position = Vector3(-0.17, 0, 0.04)
	fb.add_child(_cover)
	box(Vector3(0.34, 0.38, 0.02), Vector3(0.17, 0, 0.0), Color(0.78, 0.78, 0.76), _cover)
	part(&"cover", Vector3(0.34, 0.38, 0.05), Vector3(0.17, 0, 0.01), _cover)
	part(&"connector", Vector3(0.12, 0.12, 0.1), Vector3(0, -0.02, 0.06), fb)
	_ext(root)
	_ext(fb)


func _build_panel() -> void:
	var p := Node3D.new()
	p.name = "CommsLinkPanel"
	p.position = PANEL
	p.rotation_degrees.y = 180.0
	add_child(p)
	box(Vector3(0.32, 0.34, 0.05), Vector3(0, 0, -0.025), Color(0.18, 0.2, 0.23), p)
	box(Vector3(0.34, 0.03, 0.07), Vector3(0, 0.18, -0.01), Color(0.25, 0.75, 0.85), p)
	label("COMMS LINK · A1", Vector3(0, 0.12, 0.004), 15, Color(0.85, 0.95, 0.95), p)
	box(Vector3(0.24, 0.04, 0.01), Vector3(0, 0.03, 0.002), Color(0.06, 0.07, 0.08), p)
	_bar = box(Vector3(0.24, 0.032, 0.012), Vector3(0, 0.03, 0.006), Color(0.3, 0.9, 0.5), p)
	_link_label = label("", Vector3(0, -0.04, 0.004), 13, Color(0.55, 0.95, 0.75), p)
	_link_lamp = lamp(Vector3(0.13, 0.12, 0.01), p)
	box(Vector3(0.1, 0.05, 0.025), Vector3(0, -0.11, 0.01), Color(0.2, 0.55, 0.3), p)
	label("TEST LINK", Vector3(0, -0.11, 0.024), 10, Color(0.95, 0.95, 0.9), p)
	part(&"test", Vector3(0.3, 0.3, 0.06), Vector3(0, 0, 0.02), p)


# ------------------------------------------------------------------ model
func comms_powered() -> bool:
	var b: Node = get_node_or_null(breaker_path)
	return b == null or not b.has_method("zone_powered") or b.zone_powered(&"communications")


func link_quality() -> float:
	var f: float = {"ok": 1.0, "corroded": 0.55, "loose": 0.35}.get(feed, 1.0)
	return f * (1.0 if comms_powered() else 0.0)


func feed_ok() -> bool:
	return feed == "ok" and not cover_open


func on_part(id: StringName) -> void:
	match id:
		&"cover":
			cover_open = not cover_open
			sfx(&"latch")
			if not cover_open and feed == "ok" and _dp != null:
				_dp.log_event("Antenna A1 feed box closed")
		&"connector":
			if not cover_open:
				say("Open the feed box cover first.")
				return
			if feed == "corroded":
				feed = "loose"
				sfx(&"scrub")
				say("Contacts cleaned. Reseat the connector.")
			elif feed == "loose":
				feed = "ok"
				sfx(&"ratchet")
				say("RF connector reseated and torqued.")
				if _dp != null:
					_dp.log_event("Antenna A1 connector reseated")
			else:
				say("Connector seated, contacts clean.")
		&"test":
			if request_day != -1 and verified_day < request_day:
				if link_quality() >= 0.95 and feed_ok():
					verified_day = _dp.day_number if _dp != null else 0
					sfx(&"success")
					say("Comms link %d %% — verified." % roundi(link_quality() * 100.0))
				else:
					link_checked = true
					sfx(&"warn")
					say("Comms link %d %% — degraded%s." % [roundi(link_quality() * 100.0), "" if comms_powered() else " (no power: breaker B-04)"])
			else:
				sfx(&"click")
				say("Comms link %d %%." % roundi(link_quality() * 100.0))
	_refresh()


func part_prompt(id: StringName) -> String:
	match id:
		&"cover": return "Click: %s feed box cover" % ("Close" if cover_open else "Open")
		&"connector":
			if not cover_open:
				return ""
			return {"corroded": "Click: Clean connector contacts", "loose": "Click: Reseat RF connector"}.get(feed, "Connector OK")
		&"test": return "Click: Test comms link (%d %%)" % roundi(link_quality() * 100.0)
	return ""


func _process(delta: float) -> void:
	_t += delta
	if _t > 0.5:
		_t = 0.0
		_refresh()


func _refresh() -> void:
	if _cover != null:
		_cover.rotation_degrees.y = -110.0 if cover_open else 0.0
	if _connector != null:
		var cm: StandardMaterial3D = _connector.material
		cm.albedo_color = {"corroded": Color(0.35, 0.55, 0.45), "loose": Color(0.75, 0.6, 0.3)}.get(feed, Color(0.85, 0.7, 0.35))
		_connector.position.z = 0.065 if feed == "loose" else 0.04
	if _box_lamp != null:
		set_lamp(_box_lamp, Color(0.3, 0.9, 0.4) if feed == "ok" else Color(1.0, 0.6, 0.1), true)
	var q: float = link_quality()
	if _bar != null:
		_bar.size.x = maxf(0.24 * q, 0.004)
		_bar.position.x = -0.12 + 0.12 * q
		(_bar.material as StandardMaterial3D).albedo_color = Color(0.3, 0.9, 0.5) if q >= 0.95 else (Color(1.0, 0.7, 0.2) if q > 0.0 else Color(0.6, 0.15, 0.1))
		_link_label.text = "LINK %d %%%s" % [roundi(q * 100.0), "" if comms_powered() else "  NO POWER"]
		set_lamp(_link_lamp, Color(0.3, 0.9, 0.4) if q >= 0.95 else Color(1.0, 0.55, 0.1), true)


# ------------------------------------------------------------- work order
func order_rearm(seed: int) -> void:
	request_day = _dp.day_number if _dp != null else 0
	feed = ["loose", "corroded"][posmod(seed, 2)]
	cover_open = false
	link_checked = false
	_refresh()


func order_feasible() -> bool:
	return feed_ok() and (request_day == -1 or verified_day >= request_day)


func order_done() -> bool:
	return request_day != -1 and verified_day >= request_day


func order_severity() -> int:
	if request_day == -1 or verified_day >= request_day:
		return 0
	return 2 if link_quality() < 0.5 else 1


func order_next() -> Dictionary:
	var eva: Node = get_tree().get_first_node_in_group(&"eva_system")
	var outside: bool = eva != null and eva.outside
	var suited: bool = eva != null and eva.suited
	if not link_checked and not feed_ok():
		return {"action": "Test the comms link", "short": "TEST LINK", "room": &"communications"}
	if not feed_ok():
		if outside:
			return {"action": "Service antenna A1 feed box", "short": "FIX FEED A1", "room": &"airlock"}
		if not suited:
			return {"action": "Put on the EVA suit (airlock)", "short": "SUIT UP", "room": &"airlock"}
		return {"action": "Airlock chamber: press EXIT", "short": "AIRLOCK EXIT", "room": &"airlock"}
	if outside:
		return {"action": "Float back into the chamber, press ENTER", "short": "AIRLOCK ENTER", "room": &"airlock"}
	return {"action": "Verify the comms link", "short": "VERIFY LINK", "room": &"communications"}


func order_progress() -> String:
	return "%d%%" % roundi(link_quality() * 100.0)


func order_detail() -> Array:
	return ["Antenna A1 (exterior, courtyard) feed: %s." % feed, "Comms link %d %%%s." % [roundi(link_quality() * 100.0), "" if comms_powered() else " — B-04 off"], "EVA: suit locker, then the airlock chamber (EXIT / ENTER). Tether rings A1-A3."]


func state_dict() -> Dictionary:
	return {"feed": feed, "cover_open": cover_open, "request_day": request_day, "link_checked": link_checked, "verified_day": verified_day}


func load_dict(d: Dictionary) -> void:
	feed = String(d.get("feed", feed))
	cover_open = bool(d.get("cover_open", cover_open))
	request_day = int(d.get("request_day", request_day))
	link_checked = bool(d.get("link_checked", link_checked))
	verified_day = int(d.get("verified_day", verified_day))
	_refresh()
