text = "GAME DIFFICULTY: NORMAL"

[node name="DifficultyDetail" type="Label" parent="Control/VBox/Content/Settings"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(580, 0)
theme_override_colors/font_color = Color(0.72, 0.78, 0.74, 1)
theme_override_font_sizes/font_size = 13
autowrap_mode = 2
text = "Applies across the whole station, not just Engineering -- every repair and diagnostic task reads this same setting.

EASY — stronger step-by-step hints, verbose diagnostics, no access screws.
NORMAL — hints only while disconnecting, balanced diagnostics, no access screws.
HARD — no wire-order hints, terse diagnostics, four access screws to open/close a cover.

Changing this applies right away to any task not yet started. A repair already in progress keeps the requirements it started with until it is finished."

